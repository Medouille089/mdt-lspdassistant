# Copy to .env and fill in your values. Never commit the real .env.

# Discord OAuth2
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=http://localhost:3001/auth/discord/callback

# Discord bot
TOKEN=
GUILD_ID=

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Sessions
SESSION_SECRET=

# Webhooks
DISCORD_WEBHOOK_LOGS=
WEBHOOK_BRACELET=

# Server
PORT=3001
NODE_ENV=development
IS_LOCAL=true
HTTPS=false

# Discord roles
DOJ_ROLE_ID=
PRESENCE_ROLE_ID=
SETROOKIE_AUTHORIZED_ROLES=
SETROOKIE_ROLES_TO_ADD=
SETROOKIE_ROLES_TO_REMOVE=

# Discord channels / categories
GITHUB_PUSH_CHANNEL_ID=
RECRUITMENT_CHANNEL_ID=
PRESENCE_CHANNEL_ID=
UPLOAD_GUILD_ID=
UPLOAD_CATEGORY_ID=
DISCORD_LOG_CHANNEL_ID=

# Misc
RECRUITMENT_BANNER_URL=
TRELLO_EFFECTIF_LIST_NAME=

# Optional DB-config fallbacks
# REQUIRED_ROLE_ID=
# LOGS_CHANNEL=
# COMMANDSTAFF_ID=
# SUPERVISOR_ROLE_ID=
# SUPERADMIN_ROLE_ID=
